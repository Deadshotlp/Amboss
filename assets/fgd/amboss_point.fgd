	_ambientHDR(color255) : "AmbientHDR" : "-1 -1 -1 1"
	_AmbientScaleHDR(float) : "AmbientScaleHDR" : "1"
	SunSpreadAngle(float) : "SunSpreadAngle" : 0
]
@PointClass base(Targetname, Angles) size(-8 -8 -8, 8 8 8) color(255 255 0) iconsprite("editor/light_spot.vmt") = light_spot : "Spotlicht." [
	target(target_destination) : "Entity to point at"
