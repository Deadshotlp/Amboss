// ---------------------------------------------------------------- Licht
@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) color(255 255 0) iconsprite("editor/light.vmt") sphere(_fifty_percent_distance) sphere(_zero_percent_distance) = light : "Punktlicht." [
	_light(color255) : "Brightness" : "255 255 255 200"
	_lightHDR(color255) : "BrightnessHDR" : "-1 -1 -1 1"
	_lightscaleHDR(float) : "BrightnessScaleHDR" : "1"
	style(choices) : "Appearance" : 0 = [ 0 : "Normal" 10 : "Fluorescent flicker" 2 : "Slow, strong pulse" 11 : "Slow pulse, noblack" 5 : "Gentle pulse" 1 : "Flicker A" 6 : "Flicker B" 3 : "Candle A" 7 : "Candle B" 8 : "Candle C" 4 : "Fast strobe" 9 : "Slow strobe" 12 : "Underwater light mutation" ]
	pattern(string) : "Custom Appearance"
	_constant_attn(string) : "Constant" : "0"
	_linear_attn(string) : "Linear" : "0"
	_quadratic_attn(string) : "Quadratic" : "1"
	_fifty_percent_distance(string) : "50 percent falloff distance" : "0"
	_zero_percent_distance(string) : "0 percent falloff distance" : "0"
	_hardfalloff(integer) : "Hard Falloff" : 0
	_distance(integer) : "Maximum Distance" : 0
	spawnflags(flags) = [ 1 : "Initially dark" : 0 ]
	input TurnOn(void) : "Einschalten"
	input TurnOff(void) : "Ausschalten"
	input Toggle(void) : "Umschalten"
	input SetPattern(string) : "Muster setzen"
	input FadeToPattern(string) : "Zu Muster überblenden"
]
