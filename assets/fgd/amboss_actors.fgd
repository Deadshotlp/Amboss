// ---------------------------------------------------------------- Props
@PointClass base(Targetname, Angles, Shadow, DXLevelChoice, SystemLevelChoice) size(-16 -16 -16, 16 16 16) color(255 255 0) studioprop() = prop_static : "Statisches Modell (wird in die Map kompiliert, günstig)." [
	model(studio) : "World Model" : "models/props_junk/wood_crate001a.mdl"
	skin(integer) : "Skin" : 0
	solid(choices) : "Collisions" : 6 = [ 0 : "Not Solid" 2 : "Use Bounding Box" 6 : "Use VPhysics" ]
	screenspacefade(choices) : "Screen Space Fade" : 0 = [ 0 : "No" 1 : "Yes" ]
	fademindist(float) : "Start Fade Dist/Pixels" : -1
	fademaxdist(float) : "End Fade Dist/Pixels" : 0
	fadescale(float) : "Fade Scale" : 1
	lightingorigin(target_destination) : "Lighting Origin"
	disablevertexlighting(choices) : "Disable Vertex lighting" : 0 = [ 0 : "No" 1 : "Yes" ]
	disableselfshadowing(choices) : "Disable Self-Shadowing with vertex lighting" : 0 = [ 0 : "No" 1 : "Yes" ]
	ignorenormals(choices) : "Ignore surface normal for computing vertex lighting" : 0 = [ 0 : "No" 1 : "Yes" ]
	modelscale(float) : "Model Scale (nur neuere Compiler)" : "1.0"
]
@PointClass base(BasePropPhysics, BreakableProp, Parentname) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_physics : "Physik-Objekt (fällt, rollt, lässt sich aufheben)." [ model(studio) : "World Model" : "models/props_junk/wood_crate001a.mdl" ]
@PointClass base(BasePropPhysics, BreakableProp, Parentname) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_physics_override : "Physik-Objekt, auch mit Modellen, die eigentlich nicht als Physik gedacht sind." [ health(integer) : "Health" : 0 ]
@PointClass base(BasePropPhysics, BreakableProp, Parentname) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_physics_multiplayer : "Physik-Objekt mit vereinfachter Multiplayer-Physik." [ physicsmode(choices) : "Physics Mode" : 0 = [ 0 : "Auto Detect" 1 : "Solid, Server-side" 2 : "Non-Solid, Server-side" 3 : "Non-Solid, Client-side" ] ]
@PointClass base(BasePropPhysics, BreakableProp, Parentname) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_physics_respawnable : "Physik-Objekt, das nach dem Zerstören wieder erscheint." [ RespawnTime(float) : "Respawn Time" : 60 ]
@PointClass base(BasePropDynamic, BreakableProp, Global) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_dynamic : "Animiertes oder bewegliches Modell (kann Parent haben)." [ model(studio) : "World Model" : "models/props_junk/wood_crate001a.mdl" ]
@PointClass base(BasePropDynamic, BreakableProp, Global) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_dynamic_override : "Wie prop_dynamic, erlaubt auch Physik-Modelle." [ health(integer) : "Health" : 0 ]
@PointClass base(BasePropDynamic) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_dynamic_ornament : "Modell, das an ein Ziel geheftet wird (z. B. Gegenstände an NPCs)." [ InitialOwner(string) : "Initial Owner" input SetAttached(string) : "Anheften an" input Detach(void) : "Lösen" ]
@PointClass base(Targetname, Angles, Studiomodel, Shadow, DXLevelChoice) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_ragdoll : "Ragdoll (schlaffe Puppe, z. B. Leichen)." [
	angleOverride(string) : "Override Animation"
	fademindist(float) : "Start Fade Dist" : -1
	fademaxdist(float) : "End Fade Dist" : 0
	spawnflags(flags) = [ 4 : "Debris - Don't collide with the player or other debris" : 1 8192 : "Allow Dissolve" : 0 16384 : "Motion Disabled" : 0 32768 : "Allow stretch" : 0 65536 : "Start asleep" : 0 ]
	input StartRagdollBoogie(void) : "Zucken lassen"
	input EnableMotion(void) : "Bewegung an"
	input DisableMotion(void) : "Bewegung aus"
]
@PointClass base(Targetname, Parentname, Angles, Global, Studiomodel, Shadow, RenderFields) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_door_rotating : "Drehtür als Modell (mit Klinke, schließt sich automatisch)." [
	model(studio) : "World Model" : "models/props_c17/door01_left.mdl"
	slavename(target_destination) : "Slave name"
	hardware(choices) : "Hardware Type" : 1 = [ 0 : "<None>" 1 : "Lever" 2 : "Push bar" 3 : "Keypad" ]
	ajarangles(angle) : "Ajar Angles (Pitch Yaw Roll)" : "0 0 0"
	spawnpos(choices) : "Spawn Position" : 0 = [ 0 : "Closed" 1 : "Open forward" 2 : "Open back" 3 : "Ajar (use Ajar Angles)" ]
	axis(axis) : "Hinge Axis"
	distance(float) : "Rotation Distance (deg)" : 90
	speed(integer) : "Speed" : 100
	soundopenoverride(sound) : "Fully Open Sound"
	soundcloseoverride(sound) : "Fully Closed Sound"
	soundmoveoverride(sound) : "Moving Sound"
	returndelay(integer) : "Delay Before close (-1 stay open)" : -1
	dmg(integer) : "Damage Inflicted When Blocked" : 0
	health(integer) : "Health (0 = Unbreakable)" : 0
	soundlockedoverride(sound) : "Locked Sound"
	soundunlockedoverride(sound) : "Unlocked Sound"
	forceclosed(choices) : "Force Closed" : 0 = [ 0 : "No" 1 : "Yes" ]
	opendir(choices) : "Open Direction" : 0 = [ 0 : "Both directions" 1 : "Forward only" 2 : "Backward only" ]
	spawnflags(flags) = [ 1 : "Starts Open" : 0 2048 : "Starts locked" : 0 4096 : "Door silent (No sound, and does not alert NPCs)" : 0 8192 : "Use closes" : 1 16384 : "Door silent to NPCS (Does not alert NPCs)" : 0 32768 : "Ignore player +USE" : 0 ]
	input Open(void) : "Öffnen"
	input OpenAwayFrom(string) : "Vom Entity weg öffnen"
	input Close(void) : "Schließen"
	input Toggle(void) : "Umschalten"
	input Lock(void) : "Verriegeln"
	input Unlock(void) : "Entriegeln"
	input SetRotationDistance(float) : "Drehwinkel setzen"
	input SetSpeed(float) : "Geschwindigkeit setzen"
	output OnClose(void) : "Beim Schließen"
	output OnOpen(void) : "Beim Öffnen"
	output OnFullyOpen(void) : "Ganz offen"
	output OnFullyClosed(void) : "Ganz geschlossen"
	output OnBlockedClosing(void) : "Beim Schließen blockiert"
	output OnBlockedOpening(void) : "Beim Öffnen blockiert"
	output OnLockedUse(void) : "Benutzt, während verriegelt"
]
@PointClass base(Targetname, Angles, Studiomodel) studioprop() size(-16 -16 -16, 16 16 16) color(255 255 0) = prop_detail : "Detail-Modell (Client, ohne Kollision; wird kompiliert)." []

