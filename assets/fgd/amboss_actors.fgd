// ---------------------------------------------------------------- Skripte
@PointClass base(Targetname, Parentname, Angles) studio("models/editor/scriptedsequence.mdl") size(-16 -16 0, 16 16 72) color(255 0 255) = scripted_sequence : "Lässt einen NPC eine Animation abspielen." [
	m_iszEntity(target_destination) : "Target NPC"
	m_iszIdle(string) : "Pre Action Idle Animation"
	m_iszEntry(string) : "Entry Animation"
	m_iszPlay(string) : "Action Animation"
	m_iszPostIdle(string) : "Post Action Idle Animation"
	m_iszCustomMove(string) : "Custom Move Animation"
	m_bLoopActionSequence(choices) : "Loop Action Animation?" : 0 = [ 0 : "No" 1 : "Yes" ]
	m_bSynchPostIdles(choices) : "Synch Post Idles?" : 0 = [ 0 : "No" 1 : "Yes" ]
	m_flRadius(integer) : "Search Radius (0=everywhere)" : 0
	m_flRepeat(integer) : "Repeat Rate ms" : 0
	m_fMoveTo(choices) : "Move to Position" : 1 = [ 0 : "No" 1 : "Walk" 2 : "Run" 3 : "Custom movement" 4 : "Instantaneous" 5 : "No - Turn to Face" ]
	m_iszNextScript(target_destination) : "Next Script"
	m_bIgnoreGravity(choices) : "Ignore Gravity on NPC during script" : 0 = [ 0 : "No" 1 : "Yes" ]
	m_bDisableNPCCollisions(choices) : "Disable NPC collisions during script" : 0 = [ 0 : "No" 1 : "Yes" ]
	spawnflags(flags) = [ 4 : "Repeatable" : 0 8 : "Leave Corpse" : 0 16 : "Start on Spawn" : 0 32 : "No Interruptions" : 0 64 : "Override AI" : 0 128 : "Don't Teleport NPC On End" : 0 256 : "Loop in Post Idle" : 0 512 : "Priority Script" : 0 4096 : "Allow actor death" : 0 ]
	input BeginSequence(void) : "Starten"
	input MoveToPosition(void) : "Zur Position gehen"
	input CancelSequence(void) : "Abbrechen"
	output OnBeginSequence(void) : "Beim Start"
	output OnEndSequence(void) : "Am Ende"
	output OnCancelSequence(void) : "Beim Abbruch"
	output OnScriptEvent01(void) : "Skript-Ereignis 1"
	output OnScriptEvent02(void) : "Skript-Ereignis 2"
]
@PointClass base(Targetname) iconsprite("editor/aiscripted_schedule.vmt") size(-8 -8 -8, 8 8 8) color(255 0 255) = aiscripted_schedule : "Erteilt einem NPC einen Befehl (zum Ziel gehen, angreifen …)." [
	m_iszEntity(target_destination) : "Target NPC"
	m_flRadius(integer) : "Search Radius (0=everywhere)" : 0
	graball(choices) : "All in radius" : 0 = [ 0 : "No" 1 : "Yes" ]
	forcestate(choices) : "AI state to set" : 0 = [ 0 : "<None>" 1 : "Set state to IDLE" 2 : "Set state to ALERT" 3 : "Set state to COMBAT" ]
	schedule(choices) : "Schedule to run" : 1 = [ 0 : "<None>" 1 : "Walk to Goal Entity" 2 : "Run to Goal Entity" 3 : "Set enemy to Goal Entity" 4 : "Walk Goal Path" 5 : "Run Goal Path" 6 : "Set enemy to Goal Entity AND Run to Goal Entity" ]
	interruptability(choices) : "Interruptability" : 0 = [ 0 : "General" 1 : "Damage or Death" 2 : "Death" ]
	goalent(target_destination) : "Goal entity"
	spawnflags(flags) = [ 4 : "Repeatable" : 1 1024 : "Search Cyclically" : 0 2048 : "Don't Clear Goal on Completion" : 0 ]
	input StartSchedule(void) : "Starten"
	input StopSchedule(void) : "Stoppen"
]
