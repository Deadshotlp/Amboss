	MaxLiveChildren(integer) : "Max Live NPCs" : 5
	spawnflags(flags) = [ 16 : "Fade Corpse" : 0 32 : "Infinite Children" : 0 64 : "Do Not Drop" : 0 128 : "Don't Spawn While Visible" : 0 ]
	input Spawn(void) : "Einen NPC erzeugen"
	input Toggle(void) : "Umschalten"
	input SetMaxChildren(integer) : "Maximale Anzahl"
	input SetSpawnFrequency(float) : "Frequenz"
	output OnSpawnNPC(string) : "NPC erzeugt"
	output OnAllSpawned(void) : "Alle erzeugt"
	output OnAllSpawnedDead(void) : "Alle erzeugten tot"
	output OnAllLiveChildrenDead(void) : "Alle lebenden tot"
]
