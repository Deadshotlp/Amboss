// ---------------------------------------------------------------- Brush-Entities
@SolidClass = worldspawn : "Die Welt (Map-Eigenschaften)." [
	message(string) : "Map Description / Title"
	skyname(string) : "SkyBox Texture Name" : "sky_day01_01"
	chaptertitle(string) : "Chapter Title Message"
	startdark(choices) : "Level Fade In" : 0 = [ 0 : "No" 1 : "Yes" ]
	gametitle(choices) : "Display Game Title" : 0 = [ 0 : "No" 1 : "Yes" ]
	newunit(choices) : "New Level Unit" : 0 = [ 0 : "No, keep current" 1 : "Yes, clear previous levels" ]
	maxoccludeearea(float) : "Max occludee area" : "0"
	minoccluderarea(float) : "Min occluder area" : "0"
	maxpropscreenwidth(float) : "Start Fade Pixels" : -1
	minpropscreenwidth(float) : "End Fade Pixels" : 0
	detailvbsp(string) : "Detail.vbsp file" : "detail.vbsp"
	detailmaterial(string) : "Detail material file" : "detail/detailsprites"
	coldworld(choices) : "World is cold" : 0 = [ 0 : "No" 1 : "Yes" ]
]
@SolidClass = func_detail : "Detail-Geometrie (blockiert keine Sichtberechnung, kein Leck-Schutz)." []
@SolidClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow, EnableDisable) = func_brush : "Brush mit Optionen (ein-/ausblendbar, Parent, Render-Einstellungen)." [
	spawnflags(flags) = [ 2 : "Ignore player +USE" : 1 ]
	Solidity(choices) : "Solidity" : 0 = [ 0 : "Toggle" 1 : "Never Solid" 2 : "Always Solid" ]
	excludednpc(string) : "NPC class excluded from collisions"
	invert_exclusion(choices) : "Invert NPC class exclusion" : 0 = [ 0 : "No" 1 : "Yes" ]
	solidbsp(choices) : "Solid BSP" : 0 = [ 0 : "No" 1 : "Yes" ]
	vrad_brush_cast_shadows(choices) : "Shadows" : 0 = [ 0 : "No shadows" 1 : "Cast shadows" ]
	input Toggle(void) : "Umschalten"
	input SetExcluded(string) : "Ausgeschlossene NPC-Klasse"
	input SetInvert(integer) : "Ausschluss umkehren"
]
@SolidClass base(Targetname, Parentname, Origin, RenderFields, Shadow) = func_illusionary : "Nicht-solider Brush (nur Optik)." []
@SolidClass base(Targetname, RenderFields, Global, Shadow) = func_wall : "Fester Brush mit Render-Einstellungen (veraltet, besser func_brush)." []
@SolidClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow) = func_wall_toggle : "An-/ausschaltbare Wand." [ spawnflags(flags) = [ 1 : "Starts Invisible" : 0 ] input Toggle(void) : "Umschalten" ]
@SolidClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow, DamageFilter) = func_breakable : "Zerbrechlicher Brush." [
	health(integer) : "Strength" : 1
	material(choices) : "Material Type" : 0 = [ 0 : "Glass" 1 : "Wood" 2 : "Metal" 3 : "Flesh" 4 : "Cinder Block" 5 : "Ceiling Tile" 6 : "Computer" 7 : "Unbreakable Glass" 8 : "Rocks" 10 : "None" ]
	explosion(choices) : "Gibs Direction" : 0 = [ 0 : "Random" 1 : "Relative to Attack" 2 : "Use Precise Gib Dir" ]
	gibdir(angle) : "Precise Gib Direction" : "0 0 0"
	nodamageforces(choices) : "Damaging it Doesn't Push It" : 0 = [ 0 : "No" 1 : "Yes" ]
	gibmodel(string) : "Gib Model"
	spawnobject(choices) : "Spawn On Break" : 0 = [ 0 : "Nothing" 1 : "item_battery" 2 : "item_healthkit" 3 : "item_ammo_pistol" 4 : "item_ammo_pistol_large" 5 : "item_ammo_smg1" 6 : "item_ammo_smg1_large" 7 : "item_ammo_ar2" 8 : "item_ammo_ar2_large" 9 : "item_box_buckshot" 10 : "item_flare_round" 11 : "item_box_flare_rounds" 12 : "item_rpg_round" 14 : "item_box_sniper_rounds" 16 : "weapon_stunstick" 18 : "weapon_ar2" 20 : "weapon_rpg" 21 : "weapon_smg1" 24 : "weapon_crossbow" 27 : "weapon_shotgun" 29 : "item_dynamic_resupply" ]
	ExplodeMagnitude(integer) : "Explode Magnitude" : 0
	pressuredelay(float) : "Pressure Delay" : 0
	minhealthdmg(integer) : "Min Damage to Hurt" : 0
	PerformanceMode(choices) : "Performance Mode" : 0 = [ 0 : "Normal" 1 : "No Gibs" 2 : "Full Gibs on All Platforms" ]
	spawnflags(flags) = [ 1 : "Only Break on Trigger" : 0 2 : "Break on Touch" : 0 4 : "Break on Pressure" : 0 512 : "Break immediately on Physics" : 0 1024 : "Don't take physics damage" : 0 2048 : "Don't allow bullet penetration" : 0 ]
	input Break(void) : "Zerbrechen"
	input SetHealth(integer) : "Stärke setzen"
	input AddHealth(integer) : "Stärke addieren"
	input RemoveHealth(integer) : "Stärke abziehen"
	output OnBreak(void) : "Beim Zerbrechen"
	output OnHealthChanged(float) : "Stärke geändert"
]
@SolidClass base(Targetname, Parentname, Global, Shadow) = func_breakable_surf : "Zerbrechliche Glasscheibe (splittert stückweise). Eine Seite mit Glas-Textur, Rest nodraw." [
	health(integer) : "Strength" : 5
	fragility(integer) : "Fragility" : 100
	surfacetype(choices) : "Surface Type" : 0 = [ 0 : "Glass" 1 : "Tile" ]
	error(choices) : "Face Error" : 0 = [ 0 : "No Error" 1 : "Multiple Textured Faces" 2 : "Non-Square Face" ]
	spawnflags(flags) = [ 1 : "Physics damage decals" : 0 2 : "Take damage from held objects" : 0 ]
	input Shatter(vector) : "Zersplittern"
	output OnBreak(void) : "Beim Zerbrechen"
]
@SolidClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow, DamageFilter) = func_physbox : "Brush mit Physik (fällt, lässt sich schieben)." [
	health(integer) : "Strength" : 0
	material(choices) : "Material Type" : 0 = [ 0 : "Glass" 1 : "Wood" 2 : "Metal" 3 : "Flesh" 4 : "Cinder Block" 5 : "Ceiling Tile" 6 : "Computer" 7 : "Unbreakable Glass" 8 : "Rocks" ]
	massScale(float) : "Mass Scale" : "0"
	overridescript(string) : "Override Parameters"
