	input PressOut(void) : "Herauslassen"
	output OnDamaged(void) : "Bei Schaden"
	output OnPressed(void) : "Beim Drücken"
	output OnUseLocked(void) : "Benutzt, während gesperrt"
	output OnIn(void) : "Ganz drin"
	output OnOut(void) : "Ganz draußen"
]
