@SolidClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow) = func_tracktrain : "Zug entlang von path_track (fahrbar oder gesteuert)." [
	target(target_destination) : "First Stop Target"
	startspeed(integer) : "Max Speed (units / second)" : 100
	speed(integer) : "Initial Speed (units / second)" : 0
	velocitytype(choices) : "Change Velocity" : 0 = [ 0 : "Instantaneously" 1 : "Linear blend" 2 : "Ease in/ease out" ]
	orientationtype(choices) : "Change angles" : 1 = [ 0 : "Never (fixed orientation)" 1 : "Near path_tracks" 2 : "Linear blend" 3 : "Ease in/ease out" ]
	wheels(integer) : "Distance Between the Wheels" : 50
	height(integer) : "Height above track" : 4
	bank(string) : "Bank Angle on Turns" : "0"
	dmg(integer) : "Damage on Crush" : 0
	MoveSound(sound) : "Move Sound"
	StartSound(sound) : "Start Sound"
	StopSound(sound) : "Stop Sound"
	volume(integer) : "Volume (10 = loudest)" : 10
	spawnflags(flags) = [ 1 : "No Pitch (X-rot)" : 0 2 : "No User Control" : 0 8 : "Passable" : 0 16 : "Fixed Orientation" : 0 128 : "HL1 Train" : 0 256 : "Use max speed for pitch shifting move sound" : 0 512 : "Is unblockable by player" : 0 ]
	input SetSpeed(float) : "Geschwindigkeit (0–1)"
	input SetSpeedDir(float) : "Geschwindigkeit mit Richtung"
	input SetSpeedReal(float) : "Geschwindigkeit in Einheiten"
	input Stop(void) : "Anhalten"
	input StartForward(void) : "Vorwärts"
	input StartBackward(void) : "Rückwärts"
	input Resume(void) : "Weiterfahren"
	input Reverse(void) : "Richtung umkehren"
	input Toggle(void) : "Umschalten"
	input TeleportToPathTrack(target_destination) : "Zu Pfadpunkt teleportieren"
	output OnStart(void) : "Fährt los"
	output OnNext(void) : "Nächster Punkt"
]
