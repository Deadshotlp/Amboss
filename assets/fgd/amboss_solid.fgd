	forcetoenablemotion(float) : "Physics Impact Force to Override Motion" : 0
	preferredcarryangles(vector) : "Preferred Player-carry Angles" : "0 0 0"
	notsolid(choices) : "Not solid to world" : 0 = [ 0 : "Solid to World" 1 : "Passes through World" ]
	spawnflags(flags) = [ 4096 : "Start Asleep" : 0 8192 : "Ignore +USE for Pickup" : 0 16384 : "Debris - Don't collide with the player or other debris" : 0 32768 : "Motion Disabled" : 0 65536 : "Use Preferred Carry Angles" : 0 131072 : "Enable motion on Physcannon grab" : 0 262144 : "Not affected by rotor wash" : 0 524288 : "Only Break on Trigger" : 0 1048576 : "Prevent pickup" : 0 ]
	input Wake(void) : "Aufwecken"
	input Sleep(void) : "Schlafen"
	input EnableMotion(void) : "Bewegung an"
	input DisableMotion(void) : "Bewegung aus"
	input Break(void) : "Zerbrechen"
	output OnDamaged(void) : "Bei Schaden"
	output OnAwakened(void) : "Aufgewacht"
	output OnMotionEnabled(void) : "Bewegung freigegeben"
	output OnPhysGunPickup(void) : "Aufgehoben"
	output OnPhysGunDrop(void) : "Fallengelassen"
	output OnPlayerUse(void) : "Benutzt"
	output OnBreak(void) : "Beim Zerbrechen"
]
