@BaseClass base(Targetname) = KeyFrame [
	NextKey(target_destination) : "Next Key"
	MoveSpeed(integer) : "Speed (units per second)" : 64
]
@BaseClass base(Targetname, Parentname, RenderFields) = RopeKeyFrame [
	Slack(integer) : "Slack" : 25
	Type(choices) : "Type" : 0 = [ 0 : "Rope behaves like a rope" 1 : "Rope is a semi-rigid bar" 2 : "Rope moves only when its endpoints move" ]
	Subdiv(integer) : "Subdivision" : 2
	Barbed(choices) : "Barbed" : 0 = [ 0 : "No" 1 : "Yes" ]
	Width(string) : "Width (1-64)" : "2"
	TextureScale(string) : "Texture Scale" : "1"
	Collide(choices) : "Collide with world" : 0 = [ 0 : "No" 1 : "Yes" ]
	Dangling(choices) : "Start Dangling" : 0 = [ 0 : "No" 1 : "Yes" ]
	Breakable(choices) : "Breakable" : 0 = [ 0 : "No" 1 : "Yes" ]
	RopeMaterial(material) : "Rope Material" : "cable/cable.vmt"
	NoWind(choices) : "Disable Wind" : 0 = [ 0 : "No" 1 : "Yes" ]
