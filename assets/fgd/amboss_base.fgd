	output OnAquireTarget(void) : "Wenn ein Ziel erfasst wird"
	output OnLoseTarget(void) : "Wenn das Ziel verloren wird"
]
@BaseClass base(Targetname, Parentname, Angles) = BaseFilter [
	Negated(choices) : "Filter mode" : 0 = [ 0 : "Allow entities that match criteria" 1 : "Disallow entities that match criteria" ]
	input TestActivator(void) : "Aktivator prüfen"
	output OnPass(void) : "Wenn die Prüfung besteht"
	output OnFail(void) : "Wenn die Prüfung nicht besteht"
