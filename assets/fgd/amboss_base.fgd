	input SetForce(vector) : "Kraft anwenden"
	input Break(void) : "Seil reißen"
]
@BaseClass base(Targetname, Parentname, Angles) = BaseConstraint [
	constraintsystem(target_destination) : "Constraint System Manager"
	forcelimit(float) : "Force Limit to Break (lbs)" : 0
	torquelimit(float) : "Torque Limit to Break (lbs * distance)" : 0
	breaksound(sound) : "Play Sound on Break"
	teleportfollowdistance(float) : "Follow teleport distance" : 0
	spawnflags(flags) = [ 1 : "No Collision until break" : 1 4 : "Start inactive" : 0 8 : "Change mass to keep stable attachment to world" : 0 16 : "Do not connect entities until turned on" : 0 ]
	input Break(void) : "Verbindung trennen"
	input TurnOn(void) : "Verbindung aktivieren"
	input TurnOff(void) : "Verbindung deaktivieren"
	output OnBreak(void) : "Beim Reißen"
]
@BaseClass base(BaseConstraint) = TwoObjectPhysics [
	attach1(target_destination) : "Entity 1"
	attach2(target_destination) : "Entity 2"
]
@BaseClass base(Targetname, Parentname, Origin, RenderFields, Global, Shadow) = BaseBrush []
@BaseClass base(Targetname, Angles) = Node [
	nodeid(integer) : "Node ID"
]
@BaseClass base(Targetname, Angles) = HintNode [
	hinttype(choices) : "Hint" : 0 = [ 0 : "None" 2 : "World: Window" 12 : "World: Act Busy Hint" 13 : "World: Visually Interesting" 14 : "World: Visually Interesting (Don't aim at)" 15 : "World: Inhibit Combine Mines within 15 feet" 16 : "World: Visually Interesting (Stealth mode)" 100 : "Crouch Cover Medium" 101 : "Crouch Cover Low" 102 : "Waste Scanner Spawn" 103 : "Entrance / Exit Pinch" 104 : "Guard Point" 105 : "Enemy Disadvantage Point" 106 : "Health Kit" 400 : "Antlion: Burrow Point" 401 : "Antlion: Thumper Flee Point" 450 : "Headcrab: Burrow Point" 451 : "Headcrab: Exit Pod Point" 500 : "Roller: Patrol Point" 501 : "Roller: Cleanup Spot" 700 : "Crow: Fly to point" 701 : "Crow: Perch point" 900 : "Follower: Wait point" 901 : "Override jump permission" 902 : "Player squad transition point" 903 : "NPC exit point" 904 : "Strider node" 950 : "Player Ally: Push away destination" 951 : "Player Ally: Fear withdrawal destination" 1000 : "HL1 World: Machinery" 1100 : "Antlion: Charge spot" ]
	hintactivity(string) : "Hint Activity"
	nodeFOV(choices) : "Node FOV" : 180 = [ 45 : "45 Degrees" 90 : "90 Degrees" 180 : "180 Degrees" 360 : "360 Degrees" ]
	StartHintDisabled(choices) : "Start Hint Disabled" : 0 = [ 0 : "No" 1 : "Yes" ]
	Group(string) : "Hint Group"
	TargetNode(node_dest) : "Target node" : -1
	IgnoreFacing(choices) : "Ignore Facing" : 2 = [ 0 : "No" 1 : "Yes" 2 : "Default" ]
	MinimumState(choices) : "Minimum State" : 1 = [ 1 : "Idle" 2 : "Alert" 3 : "Combat" ]
	MaximumState(choices) : "Maximum State" : 3 = [ 1 : "Idle" 2 : "Alert" 3 : "Combat" ]
	input EnableHint(void) : "Hinweis aktivieren"
	input DisableHint(void) : "Hinweis deaktivieren"
]
@BaseClass base(Targetname) = GameEntity [ spawnflags(flags) = [ 1 : "Remove On fire" : 0 ] ]
